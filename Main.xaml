      <ScrollViewer x:Name="BackupPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
            <StackPanel>
              <TextBlock Style="{StaticResource GuideTitle}" Text="Antes de formatar ou trocar de computador"/>
              <TextBlock Style="{StaticResource GuideBody}" Margin="0,2,0,5">
                <Run FontWeight="Bold">1.</Run> Clique em <Run FontWeight="SemiBold">Salvar backup</Run> e escolha onde criar a pasta.
              </TextBlock>
              <TextBlock Style="{StaticResource GuideBody}" Margin="0,0,0,5">
                <Run FontWeight="Bold">2.</Run> O SpentZ cria uma pasta com o aplicativo e uma cópia dos seus dados.
                Copie a <Run FontWeight="SemiBold">pasta inteira</Run> para um pendrive, HD externo ou nuvem. Você também pode salvá-la diretamente lá.
              </TextBlock>
              <TextBlock Style="{StaticResource GuideBody}">
                <Run FontWeight="Bold">3.</Run> Confira se a pasta abre no destino antes de formatar. Se usar a nuvem, espere a sincronização terminar.
              </TextBlock>
              <Button x:Name="BackupSave" Content="Salvar backup" HorizontalAlignment="Left" Margin="0,12,0,0" Background="{DynamicResource Accent}" Foreground="White"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Style="{StaticResource GuideTitle}" Text="Para recuperar seus dados"/>
              <TextBlock Style="{StaticResource GuideBody}" Margin="0,2,0,5">
                <Run FontWeight="Bold">1.</Run> Copie a pasta de backup do pendrive ou da nuvem de volta para o computador. Abra o <Run FontWeight="SemiBold">SpentZ.exe</Run> que está dentro dela.
              </TextBlock>
              <TextBlock Style="{StaticResource GuideBody}" Margin="0,0,0,5">
                <Run FontWeight="Bold">2.</Run> Vá em <Run FontWeight="SemiBold">Configurações → Backup e restauração</Run> e clique em <Run FontWeight="SemiBold">Restaurar backup</Run>.
              </TextBlock>
              <TextBlock Style="{StaticResource GuideBody}">
                <Run FontWeight="Bold">3.</Run> Confira a pasta sugerida ou use <Run FontWeight="SemiBold">Procurar pasta</Run>, se ela foi movida ou renomeada.
                Ao confirmar, o backup substitui os dados atuais do SpentZ.
              </TextBlock>
              <Button x:Name="BackupRestore" Content="Restaurar backup" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <WrapPanel Margin="2,12,0,0">
            <TextBlock x:Name="LastBackupInfo" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,4"/>
            <Button x:Name="OpenLastBackup" Content="Abrir pasta do último backup" Margin="0,0,0,4" Style="{StaticResource Example}"/>
          </WrapPanel>
          <TextBlock x:Name="BackupStatus" Foreground="{DynamicResource AccentText}" Margin="2,12,2,0" Visibility="Collapsed"
                     AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="HelpPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource Hero}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Registre seu primeiro gasto" FontSize="21" FontWeight="Bold" Foreground="White"/>
              <TextBlock Foreground="{DynamicResource OnAccentMuted}" Margin="0,6,0,12" LineHeight="21">
                No chat, digite <Run FontWeight="Bold">42,90 almoço</Run> e clique em <Run FontWeight="Bold">Registrar</Run>.
                O aplicativo salva R$ 42,90 em Alimentação. Use vírgula para os centavos.
              </TextBlock>
              <Button x:Name="HelpOpenChat" Content="Abrir o chat" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <UniformGrid Columns="2" Margin="-6,0,-6,0">
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Registrar um ganho"/>
                <TextBlock Style="{StaticResource GuideBody}">
                  Digite <Run FontWeight="SemiBold">recebi 150 freela</Run> no chat. Para escolher a data ou a categoria,
                  abra <Run FontWeight="SemiBold">Ganhos</Run> e clique em <Run FontWeight="SemiBold">Adicionar ganho</Run>.
                </TextBlock>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Entender o saldo do mês"/>
                <TextBlock Style="{StaticResource GuideBody}">
                  Abra <Run FontWeight="SemiBold">Resumo mensal</Run> para ver o total que entrou e saiu. Use as setas ou clique no nome do mês para escolher outro período.
                </TextBlock>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Corrigir ou remover um gasto"/>
                <TextBlock Style="{StaticResource GuideBody}">
                  Se a compra não aconteceu, clique em <Run FontWeight="SemiBold">Desfazer</Run> no chat e confirme.
                  Para um lançamento antigo, selecione a linha em <Run FontWeight="SemiBold">Lançamentos</Run> e clique em Editar ou Excluir.
                </TextBlock>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Salvar os gastos do mês"/>
                <TextBlock Style="{StaticResource GuideBody}">
                  Em <Run FontWeight="SemiBold">Lançamentos</Run>, escolha o mês e clique em <Run FontWeight="SemiBold">Exportar mês</Run>.
                  Escolha onde salvar o arquivo CSV. Você pode abri-lo em um programa de planilhas.
                </TextBlock>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Planejar contas futuras"/>
                <TextBlock Style="{StaticResource GuideBody}" Text="No chat, clique em Gasto fixo e escolha conta mensal, assinatura, compra parcelada ou conta avulsa. Em Contas futuras, consulte os vencimentos. Marcar como paga registra a despesa pela data do pagamento ou vincula um lançamento existente."/>
                <TextBlock Style="{StaticResource GuideBody}" Text="Depois de cancelar com o serviço, use Cancelar renovação. As próximas renovações saem da agenda. As cobranças anteriores em aberto continuam visíveis até você pagar ou dispensar."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Guardar dinheiro no Cofrinho"/>
                <TextBlock Style="{StaticResource GuideBody}" Text="Abra o Cofrinho e escolha Depositar ou Sacar. Informe o local, o valor e a data. O saque volta ao saldo disponível do mês. Acompanhe os saldos por local na aba Cofrinho e as movimentações no Resumo mensal e no fechamento."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Criar categorias e limites"/>
                <TextBlock Style="{StaticResource GuideBody}" Text="No Resumo mensal, clique em Criar categoria para adicionar um nome novo, como Cigarro. Depois use Definir limite e escolha uma categoria da lista. Envie 20 cigarro no Chat para classificar o gasto automaticamente."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="16">
              <StackPanel>
                <TextBlock Style="{StaticResource GuideTitle}" Text="Corrigir saldo e registrar devoluções"/>
                <TextBlock Style="{StaticResource GuideBody}" Text="Use Ajustar saldo no Resumo quando souber o saldo correto, mas desconhecer a origem da diferença. Para um erro ao informar o saldo de partida, abra Configurações e use Corrigir saldo inicial. Se uma compra foi devolvida, selecione-a em Lançamentos e use Registrar estorno."/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Background="{DynamicResource AccentSoft}" CornerRadius="11" Padding="15,10">
            <TextBlock Foreground="{DynamicResource AccentText}" FontSize="13">
              <Run FontWeight="SemiBold">Seus dados ficam neste computador.</Run> Você pode usar o app sem internet.
            </TextBlock>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
