<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpentZ" Width="1120" Height="760" MinWidth="780" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" FontFamily="Segoe UI"
        FontSize="14" Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <DataTemplate x:Key="ReservePlaceLine">
      <DockPanel Margin="0,0,0,4">
        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountDisplay}" FontWeight="SemiBold" Margin="12,0,0,0"/>
        <TextBlock Text="{Binding Place}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="ReserveMoveLine">
      <DockPanel Margin="0,2,0,3">
        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountDisplay}" FontWeight="SemiBold" Margin="12,0,0,0"/>
        <TextBlock Text="{Binding SummaryLabel}" Foreground="{DynamicResource Muted}"/>
      </DockPanel>
    </DataTemplate>
    <Style x:Key="VisibleFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Control">
            <Border BorderBrush="{DynamicResource FocusOutline}" BorderThickness="2" CornerRadius="9" Margin="-3"
                    SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputOutline}"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputOutline}"/>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource Canvas}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="Decrease" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="Increase" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="{DynamicResource InputOutline}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Muted}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="12"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSelection}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Picker" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputOutline}" BorderThickness="1" CornerRadius="6">
                      <TextBlock Text="▾" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,9,0" Foreground="{DynamicResource Muted}"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="9,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     Focusable="False" AllowsTransparency="True">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputOutline}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Picker" Property="Opacity" Value=".55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocus}"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".64"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource NavText}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="Example" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>
    <Style x:Key="GuideTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="GuideBody" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" ClipToBounds="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSelection}"/>
          <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Padding="17,24,17,16" Background="{DynamicResource Sidebar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,34">
          <Image x:Name="BrandIcon" Width="44" Height="44" HorizontalAlignment="Left"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="SpentZ" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,13,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5,0,0,4">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource NavDot}" Margin="0,0,7,0"/>
          <TextBlock Text="Dados neste computador" Foreground="{DynamicResource NavText}" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12">
          <Button x:Name="SettingsNav" Content="Configurações" Style="{StaticResource Nav}" Margin="0,0,0,5"/>
          <Button x:Name="ThemeToggle" Content="Modo noturno" Style="{StaticResource Nav}" Margin="0"
                  ToolTip="Alternar entre modo claro e noturno"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Button x:Name="ChatNav" Content="Chat" Style="{StaticResource Nav}"/>
          <Button x:Name="SummaryNav" Content="Resumo mensal" Style="{StaticResource Nav}"/>
          <Button x:Name="IncomeNav" Content="Ganhos" Style="{StaticResource Nav}"/>
          <Button x:Name="ReservesNav" Content="Cofrinho" Style="{StaticResource Nav}"/>
          <Button x:Name="BillsNav" Content="Contas futuras" Style="{StaticResource Nav}"/>
          <Button x:Name="HistoryNav" Content="Lançamentos" Style="{StaticResource Nav}"/>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20">
        <StackPanel x:Name="MonthBar" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
          <Border CornerRadius="11" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" Padding="4">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PrevMonth" Content="‹" FontSize="20" Padding="12,3" AutomationProperties.Name="Mês anterior"/>
              <Button x:Name="MonthPicker" MinWidth="130" Margin="6,0" Padding="4,4"
                      ToolTip="Escolher mês e ano (Ctrl+G)" AutomationProperties.Name="Escolher mês e ano"/>
              <Button x:Name="NextMonth" Content="›" FontSize="20" Padding="12,3" AutomationProperties.Name="Próximo mês"/>
            </StackPanel>
          </Border>
          <Button x:Name="ReturnCurrentMonth" Content="Voltar ao mês atual" Style="{StaticResource Example}"
                  Margin="0,6,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel>
          <Button x:Name="NavigateBack" Content="‹  Voltar" Style="{StaticResource Example}" Margin="0,0,0,6"
                  HorizontalAlignment="Left" Visibility="Collapsed" ToolTip="Voltar à seção (Alt + seta para a esquerda)"/>
          <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="Bold" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
          <TextBlock x:Name="PageDescription" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
      <Button x:Name="ReminderOpen" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,12" Padding="12,7"
              HorizontalContentAlignment="Left" AutomationProperties.LiveSetting="Polite"/>
      <Border x:Name="ChatPage" Grid.Row="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="22,20">
            <StackPanel x:Name="Messages"/>
          </ScrollViewer>
          <Border Grid.Row="1" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel>
              <DockPanel>
                <Button x:Name="Send" Content="Registrar" DockPanel.Dock="Right" Background="{DynamicResource Accent}" Foreground="White" Margin="10,0,0,0"/>
                <TextBox x:Name="ChatInput" BorderBrush="{DynamicResource InputOutline}" BorderThickness="1" Padding="10,7"
                         VerticalContentAlignment="Center" MaxLength="240" AutomationProperties.Name="Mensagem com valor e descrição do lançamento"/>
              </DockPanel>
              <WrapPanel Margin="0,9,0,0">
                <TextBlock Text="Exemplos" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,9,4"/>
                <Button x:Name="ExampleMeal" Content="42,90 almoço" Style="{StaticResource Example}" ToolTip="Preencher a mensagem"/>
                <Button x:Name="ExampleRide" Content="15 Uber" Style="{StaticResource Example}" ToolTip="Preencher a mensagem"/>
                <Button x:Name="ExampleIncome" Content="recebi 150 freela" Style="{StaticResource Example}" ToolTip="Preencher a mensagem"/>
              </WrapPanel>
              <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="Cadastro rápido" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,4"/>
                <Button x:Name="QuickExpense" Content="Gasto" Style="{StaticResource Example}"/>
                <Button x:Name="QuickIncome" Content="Ganho" Style="{StaticResource Example}"/>
                <Button x:Name="QuickFixedExpense" Content="Gasto fixo" Style="{StaticResource Example}"/>
                <Button x:Name="QuickFixedIncome" Content="Ganho fixo" Style="{StaticResource Example}"/>
                <Button x:Name="QuickCofrinho" Content="Cofrinho" Style="{StaticResource Example}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer x:Name="SummaryPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <WrapPanel Margin="0,0,0,8">
            <Button x:Name="OpenClosures" Content="Fechamento" Margin="0,0,8,4"/>
            <Button x:Name="AdjustBalance" Content="Ajustar saldo" Margin="0,0,8,4"/>
            <Button x:Name="OpenNextBills" Content="Contas do próximo mês" Margin="0,0,0,4"/>
          </WrapPanel>
          <Border Style="{StaticResource Card}" Padding="16,11" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="SummaryAvailable" Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="Bold"
                         ToolTip="Saldo conforme os lançamentos e as movimentações do Cofrinho."/>
              <TextBlock x:Name="ForecastTitle" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
              <TextBlock x:Name="ForecastBalance" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"/>
              <Expander x:Name="ForecastDetails" Header="Como a previsão foi calculada" Margin="0,10,0,0">
                <StackPanel Margin="0,6,0,0">
                  <TextBlock x:Name="SummaryOpening" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,4" Visibility="Collapsed"/>
                  <TextBlock x:Name="SummaryCommitments" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
              <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Limites do mês" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,4"/>
                <Button x:Name="CreateCategory" Content="Criar categoria" Margin="0,0,6,4"/>
                <Button x:Name="BudgetSettings" Content="Definir limite" Margin="0,0,0,4"/>
              </WrapPanel>
              <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CategoryLimits"/>
              </ScrollViewer>
              <TextBlock x:Name="BudgetStatus" Foreground="{DynamicResource AccentText}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="16,11" Margin="0,0,0,16">
            <Expander Header="Detalhes do mês">
            <StackPanel Margin="0,8,0,0">
            <TextBlock x:Name="SummaryExpensesSinceOpening" FontWeight="SemiBold" Margin="0,0,0,8" Visibility="Collapsed"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Entradas do mês" Foreground="{DynamicResource Muted}" FontSize="12"/>
                <TextBlock x:Name="SummaryIncome" Foreground="{DynamicResource IncomeInk}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Resultado do mês" Foreground="{DynamicResource Muted}" FontSize="12" ToolTip="Ganhos menos despesas registradas no mês"/>
                <TextBlock x:Name="SummaryBalance" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <TextBlock Text="Despesas do mês completo" Foreground="{DynamicResource Muted}" FontSize="12"/>
                <TextBlock x:Name="Total" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ExpenseInk}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="Comparison" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
            <TextBlock x:Name="Count" Foreground="{DynamicResource Muted}" FontSize="12"/>
            <TextBlock x:Name="Average" Foreground="{DynamicResource Muted}" FontSize="12"/>
            </StackPanel>
            </Expander>
          </Border>
          <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button x:Name="SummaryCofrinho" DockPanel.Dock="Right" Content="Cofrinho" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="Dinheiro guardado até este mês" Foreground="{DynamicResource Muted}" FontSize="12"/>
                  <TextBlock x:Name="SummaryReserve" FontSize="19" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="SummaryReservePlaces" ItemTemplate="{StaticResource ReservePlaceLine}"/>
              <TextBlock x:Name="SummaryReserveActivity" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
              <Expander x:Name="SummaryReserveDetails" Header="Movimentações de reserva do mês" Margin="0,6,0,0"
                        Foreground="{DynamicResource AccentText}" Visibility="Collapsed">
                <ItemsControl x:Name="SummaryReserveMoves" ItemTemplate="{StaticResource ReserveMoveLine}" Margin="18,5,0,0"/>
              </Expander>
            </StackPanel>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Gastos por dia" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ChartHint" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,14"/>
                <StackPanel x:Name="Trend"/>
                <Border x:Name="PeakCard" Background="{DynamicResource AccentSoft}" CornerRadius="9" Margin="0,16,0,0" Padding="11,8">
                  <StackPanel>
                    <TextBlock Text="Dia de maior gasto" Foreground="{DynamicResource AccentText}" FontSize="12"/>
                    <TextBlock x:Name="Peak" FontWeight="SemiBold" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Por categoria" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Participação no total do mês" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,14"/>
                <StackPanel x:Name="Categories"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="ClosuresPage" Grid.Row="2" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource GuideTitle}" Text="Meses salvos" Margin="4,0,0,10"/>
              <TextBlock x:Name="ClosureEmpty" DockPanel.Dock="Top" Style="{StaticResource GuideBody}" Margin="4,0,0,10"
                         Text="Os meses com lançamentos aparecem aqui. Abra Fechamento pelo Resumo para ver a prévia do mês atual."/>
              <DataGrid x:Name="ClosureGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                        CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Outline}" RowHeight="39"
                        BorderBrush="{DynamicResource Outline}" Background="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource Alternate}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mês" Binding="{Binding MonthDisplay}" SortMemberPath="Month" Width="*" MinWidth="100"/>
                  <DataGridTextColumn Header="Saldo" Binding="{Binding BalanceDisplay}" SortMemberPath="Balance" Width="95"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border x:Name="ClosureChart" Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <WrapPanel Margin="0,0,0,5">
                  <TextBlock x:Name="ClosureMonth" Style="{StaticResource GuideTitle}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                  <Button x:Name="ClosureBills" Content="Contas a pagar" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock x:Name="ClosureKind" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                <TextBlock x:Name="ClosureCount" Foreground="{DynamicResource Muted}" Margin="0,0,0,15"/>
                <TextBlock Text="Entradas" Foreground="{DynamicResource IncomeInk}" FontWeight="SemiBold"/>
                <TextBlock x:Name="ClosureIncome" Margin="0,2,0,4"/>
                <ProgressBar x:Name="ClosureIncomeBar" Maximum="1" Height="9" BorderThickness="0"
                             Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource IncomeInk}"/>
                <TextBlock Text="Despesas" Foreground="{DynamicResource ExpenseInk}" FontWeight="SemiBold" Margin="0,14,0,0"/>
